# ─── CodVedha LMS Backend Environment (example) ──────────────────
# Copy this file to `.env` and fill in real values.

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Database (PostgreSQL / Supabase)
# Supabase session pooler (port 5432) works for both app + prisma db push:
# DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codvedha_lms?schema=public"

# (Production, recommended) CA certificate for verifying the DB server's TLS cert.
# Accepts either the PEM contents inline or a path to a .pem/.crt file. When set,
# the DB connection verifies the server identity (defeats MITM) instead of
# disabling verification. For Supabase, download the project's CA cert from
# Project Settings > Database > SSL configuration.
# DATABASE_CA_CERT=""

# JWT Secrets (generate strong random values for production)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Seed Admin Account
ADMIN_EMAIL="admin@codvedha.com"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="Administrator"

# SMTP (optional — leave blank to disable email)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@codvedha.com"

# S3 Storage (AWS S3 or Bunny.net S3-compatible storage)
AWS_ACCESS_KEY_ID="your-storage-zone-name-or-key"
AWS_SECRET_ACCESS_KEY="your-bunny-storage-zone-api-password"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-storage-zone-name"
# Optional: Set endpoint for Bunny.net S3 (e.g., https://storage.bunnycdn.com or https://ny.storage.bunnycdn.com)
AWS_S3_ENDPOINT="https://storage.bunnycdn.com"
# Optional: Set custom CDN domain / Bunny Pull Zone (e.g., https://myzone.b-cdn.net)
AWS_S3_CUSTOM_DOMAIN=""
