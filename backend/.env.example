# ─── CodVedha LMS Backend Environment (example) ──────────────────
# Copy this file to `.env` and fill in real values.

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Database (PostgreSQL / Supabase)
# Supabase session pooler (port 5432) works for both app + prisma db push:
# DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codvedha_lms?schema=public"

# JWT Secrets (generate strong random values for production)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Seed Admin Account
ADMIN_EMAIL="admin@codvedha.com"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="Administrator"

# SMTP (optional — leave blank to disable email)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@codvedha.com"

# AWS S3 (optional — for material/video uploads)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""
